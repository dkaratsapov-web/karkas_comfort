# Конфигурация nginx для сайта «Каркас Комфорт» на VPS.
# Файл разворачивается скриптом server/bootstrap.sh: он подставляет домен
# вместо __DOMAIN__, путь к сокету PHP-FPM и способ включения HTTP/2
# (до nginx 1.25 это флаг в listen, с 1.25 — отдельная директива),
# затем кладёт результат в /etc/nginx/sites-available/.
#
# Здесь повторено всё, что на обычном хостинге делает .htaccess:
# https и один канонический адрес, чистые URL без .html, редиректы со
# старых адресов, кеш, сжатие, защита служебных файлов и приём заявок
# через PHP-FPM.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    # certbot подменит этот блок на редирект в https и добавит свой server
    location /.well-known/acme-challenge/ { root /var/www/__DOMAIN__/public; }
    location / { return 301 https://__DOMAIN__$request_uri; }
}

server {
    listen 443 ssl__HTTP2_LISTEN__;
    listen [::]:443 ssl__HTTP2_LISTEN__;
__HTTP2_DIRECTIVE__    server_name www.__DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://__DOMAIN__$request_uri;
}

server {
    listen 443 ssl__HTTP2_LISTEN__;
    listen [::]:443 ssl__HTTP2_LISTEN__;
__HTTP2_DIRECTIVE__    server_name __DOMAIN__;

    root /var/www/__DOMAIN__/public;
    index index.html;
    charset utf-8;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # --- заголовки безопасности ---
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # включите после того, как убедитесь, что сайт полностью работает по https:
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # --- сжатие ---
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/javascript application/json
               application/xml image/svg+xml application/manifest+json;

    client_max_body_size 8m;

    # --- старый домен уводим на новый ---
    if ($host ~* ^(www\.)?karkascomfort\.ru$) { return 301 https://__DOMAIN__$request_uri; }

    # --- карточки проектов переехали из ?id= в отдельные страницы ---
    location = /proekt.html {
        if ($arg_id ~ "^[a-z0-9-]+$") { return 301 /proekty/$arg_id/; }
        return 301 /proekty/;
    }

    # --- index.html в адресе не нужен ---
    location = /index.html { return 301 /; }

    # --- адреса с .html уводим на чистые ---
    location ~ ^/proekty/([a-z0-9-]+)\.html$ { return 301 /proekty/$1/; }
    location ~ ^/([a-z0-9-]+)\.html$ {
        if ($uri = /404.html) { break; }
        return 301 /$1/;
    }

    # --- старые адреса ---
    location ~ ^/karkasnye-doma/?$ { return 301 /; }
    location ~ ^/about/?$          { return 301 /o-kompanii/; }
    location ~ ^/contacts/?$       { return 301 /kontakty/; }
    location ~ ^/objects/?$        { return 301 /obekty/; }

    # --- служебное закрыто ---
    location ~ /\.                                   { deny all; }
    location = /api/config.php                       { deny all; }
    location = /api/leads.csv                        { deny all; }
    location ~* ^/(package(-lock)?\.json|README\.md|DEPLOY\.md)$ { deny all; }

    # --- приём заявок ---
    location = /api/lead.php {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:__PHP_SOCK__;
        fastcgi_read_timeout 30s;
    }
    location ~ \.php$ { deny all; }   # других скриптов на сайте нет

    # --- статика: версия файла стоит в адресе (?v=…), можно кешировать надолго ---
    location ~* \.(css|js|woff2|svg|png|jpe?g|webp|ico|mp4)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # --- разметку не кешируем: правки должны быть видны сразу ---
    location ~* \.(html|xml|txt|webmanifest)$ {
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    # --- чистые адреса: /obekty/ отдаёт /obekty/index.html,
    #     адрес без слеша получает редирект на канонический со слешем ---
    location / {
        try_files $uri $uri/ $uri/index.html @slash;
    }
    location @slash {
        return 301 $uri/;
    }

    error_page 404 /404.html;
    location = /404.html { internal; }

    access_log /var/log/nginx/__DOMAIN__.access.log;
    error_log  /var/log/nginx/__DOMAIN__.error.log;
}
