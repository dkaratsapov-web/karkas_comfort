# Каркас Комфорт — пример конфигурации nginx.
# Подставьте свои пути к сертификатам и корню сайта.

server {
    listen 80;
    server_name karkascomfort.ru www.karkascomfort.ru;
    return 301 https://karkascomfort.ru$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.karkascomfort.ru;
    ssl_certificate     /etc/letsencrypt/live/karkascomfort.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/karkascomfort.ru/privkey.pem;
    return 301 https://karkascomfort.ru$request_uri;
}

server {
    listen 443 ssl http2;
    server_name karkascomfort.ru;
    root /var/www/karkascomfort/dist;
    index index.html;
    charset utf-8;

    ssl_certificate     /etc/letsencrypt/live/karkascomfort.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/karkascomfort.ru/privkey.pem;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Редиректы со старых адресов
    location = /karkasnye-doma/         { return 301 /karkasnye-doma.html; }
    location ~ ^/proekty/([a-z0-9-]+)\.html$ { return 301 /proekty/$1/; }
    location ~ ^/([a-z0-9-]+)\.html$         { return 301 /$1/; }
    #  Внимание: /proekty/<проект>.html — реальные страницы проектов.
    #  На каталог отправляем только те адреса, которым не соответствует файл.
    location /proekty/ {
        try_files $uri $uri/index.html @proekty_catalog;
    }
    location @proekty_catalog { return 301 /proekty/; }


    # Служебные файлы приёма заявок наружу не отдаём:
    # leads.csv содержит телефоны клиентов, config.php — доступы к почте, Telegram и CRM.
    location ~ ^/api/(config\.php$|.*\.(csv|log|json|md)$) {
        return 404;
    }

    # Приём заявок (нужен php-fpm)
    location /api/ {
        try_files $uri =404;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }

    location ~* \.(css|js|woff2|svg|png|jpe?g|webp|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location / {
        try_files $uri $uri/index.html $uri/ =404;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    error_page 404 /404.html;
}
