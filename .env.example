# Доступы к хостингу для выгрузки по FTP.
# Скопируйте этот файл в .env и заполните — .env в репозиторий не попадает.

FTP_HOST=ftp.karkascomfort.ru
FTP_USER=имя_пользователя
FTP_PASSWORD=пароль
FTP_PORT=21

# Папка сайта на хостинге. Обычно /public_html, у некоторых — /www или /htdocs
FTP_REMOTE_DIR=/public_html

# FTPS (шифрование). Если хостинг его не поддерживает — поставьте false
FTP_SECURE=true
FTP_STRICT_TLS=false
